# ==============================================================================
# WECICE Delhi Attendance & Payroll System - Backend Environment Configuration
# ==============================================================================

PORT=5000
NODE_ENV=development

# Database Connection (MongoDB)
# Provide your new MongoDB connection string here
MONGODB_URI=

# Authentication & Security
JWT_SECRET=your_jwt_secret_key_here

# Super Admin Bootstrap Credentials
SUPER_ADMIN_EMAIL=
SUPER_ADMIN_PASSWORD=
ADMIN_NAME=Administrator

# Employee ID Configuration
EMPLOYEE_ID_PREFIX=WECICE-EMP-

# Timezone & Geolocation
TIMEZONE=Asia/Kolkata
GEOAPIFY_API_KEY=
OFFICE_IPS=127.0.0.1,::1

# Email Service (Gmail SMTP for notifications/resets)
GMAIL_USER=
GMAIL_APP_PASSWORD=

# Allowed Client URLs (CORS)
CLIENT_URL=http://localhost:5173
FRONTEND_URL=http://localhost:5173

# Document Storage - Supabase Configuration (Optional - falls back to local uploads if omitted)
SUPABASE_URL=
SUPABASE_KEY=
SUPABASE_SECRET_KEY=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_BUCKET_NAME=employee-documents
